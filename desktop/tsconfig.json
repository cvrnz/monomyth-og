{
  "extends": "./.hutch/devkit/tsconfig.json",
  "compilerOptions": {
    "target": "es2022",
    "lib": ["ES2022", "DOM"],
    "types": ["bun"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src", "scripts", "electrobun.config.ts"]
}
