<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="Monomyth"
        Arguments=""
        InstallLocation="C:\Program Files\Carlos Hernandez\Monomyth">
    </Installer>
    <PackageInformation
        PackageName="Monomyth"
        PackageDisplayName="Monomyth"
        PublisherName="CN=Carlos Hernandez"
        PublisherDisplayName="Carlos Hernandez"
        Version="0.1.0.0"
        PackageDescription="Edits files in an OpenShift or Dev Spaces container">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.carlos.monomyth"
                Description="Edits files in an OpenShift or Dev Spaces container"
                DisplayName="Monomyth"
                ExecutableName="Monomyth"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Monomyth</DisplayName>
            <PublisherDisplayName>Carlos Hernandez</PublisherDisplayName>
            <Description>Edits files in an OpenShift or Dev Spaces container</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="monomyth.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
